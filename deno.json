{
  "tasks": {
    "fmt": "deno fmt",
    "lint": "deno lint",
    "test": "deno test --frozen",
    "typecheck": "deno check --frozen *.js",
    "check": "deno fmt --check && deno task lint && deno task typecheck && deno task test",
    "serve": "deno run --frozen --allow-net --allow-read --allow-write --allow-env=ANDFS_DATA serve.js"
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@1.0.19",
    "@std/cli/parse-args": "jsr:@std/cli@1.0.32/parse-args",
    "@std/path": "jsr:@std/path@1.1.6",
    "@std/fs": "jsr:@std/fs@1.0.24"
  },
  "compilerOptions": {
    "checkJs": true,
    "noImplicitAny": false,
    "useUnknownInCatchVariables": false,
    "lib": [
      "deno.window",
      "dom",
      "dom.iterable"
    ]
  },
  "fmt": {
    "singleQuote": true,
    "semiColons": false,
    "proseWrap": "preserve"
  },
  "exclude": [
    "andfs-data/",
    "coverage/",
    "dist/"
  ],
  "lint": {
    "rules": {
      "exclude": [
        "no-import-prefix"
      ]
    }
  }
}
